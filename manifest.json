{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "Cut the Fluff",
  "short_name": "Cut the Fluff",
  "version": "1.4.0",
  "description": "Rewrite wordy text into clear, natural writing—right where you work.",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage", "sidePanel"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "popup.html" },
  "commands": {
    "cut-the-fluff": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Rewrite the selected text with Cut the Fluff"
    }
  },
  "action": {
    "default_title": "Cut the Fluff",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
